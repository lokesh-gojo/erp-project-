PORT=5001
JWT_SECRET=your_production_jwt_secret_min_32_chars

# --- Primary Database: Supabase PostgreSQL ---
# From Supabase Dashboard > Project Settings > Database > Connection string (URI)
DATABASE_URL=postgresql://postgres.your_project_ref:your_password@aws-0-region.pooler.supabase.com:6543/postgres

# --- AI/ML & RAG Microservice (FastAPI on Port 5002) ---
ML_SERVICE_URL=http://127.0.0.1:5002

# --- Google Gemini API (for RAG & Question Generation) ---
GEMINI_API_KEY=your_gemini_api_key_here

# --- Supabase Storage & Service Access ---
SUPABASE_URL=https://your_project_id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
